# ==============================================================================
# Ragada Analytics - Production Environment Configuration Template
# DO NOT COMMIT ACTUAL SECRETS TO VERSION CONTROL (.gitignore protects .env)
# ==============================================================================

# Database Settings
POSTGRES_USER=saas_admin
POSTGRES_PASSWORD=ChangeMeInProduction_StrongPassword123!
POSTGRES_DB=saas_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://saas_admin:ChangeMeInProduction_StrongPassword123!@db:5432/saas_db

# Redis & Cache Settings
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Security & JWT Tokens
SECRET_KEY=change_this_to_a_cryptographically_secure_random_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Network & CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:80,http://127.0.0.1:5174

# Service Exposed Ports (Host Ports)
HOST_BACKEND_PORT=8001
HOST_FRONTEND_PORT=5174
HOST_DB_PORT=5433
HOST_REDIS_PORT=6380
