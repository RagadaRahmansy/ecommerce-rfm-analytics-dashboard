  create  table "postgres"."public_mart_gold"."fct_orders__dbt_tmp"
  
  
    as
  
  (
    -- Gold Layer: fct_orders
WITH item_cogs_agg AS (
    SELECT
        order_id,
        SUM(quantity) AS total_items_qty,
        SUM(line_cogs_idr) AS cogs_idr
    FROM "postgres"."public_stg_silver"."stg_order_items"
    GROUP BY order_id
),
customer_order_seq AS (
    SELECT
        order_id,
        ROW_NUMBER() OVER (
            PARTITION BY customer_id 
            ORDER BY ordered_at ASC
        ) AS customer_order_seq
    FROM "postgres"."public_stg_silver"."stg_orders"
)
SELECT
    o.order_id,
    o.customer_id,
    c.cohort_month AS customer_cohort_month,
    c.acquisition_channel,
    c.acquisition_campaign,
    o.sales_channel,
    o.order_status,
    o.ordered_at,
    o.order_date,
    o.order_month,
    o.payment_method,
    s.customer_order_seq,
    CASE 
        WHEN s.customer_order_seq = 1 THEN 'New Customer Order' 
        ELSE 'Repeat Customer Order' 
    END AS buyer_type,
    COALESCE(i.total_items_qty, 0) AS total_items_qty,
    o.gmv_gross_idr,
    o.realized_gross_idr,
    o.discount_amount_idr AS discount_idr,
    o.net_sales_idr,
    o.marketplace_fee_idr,
    CASE 
        WHEN o.order_status = 'completed' THEN COALESCE(i.cogs_idr, 0) 
        ELSE 0 
    END AS cogs_idr,
    o.return_shipping_loss_idr,
    (
        o.net_sales_idr - 
        o.marketplace_fee_idr - 
        (CASE WHEN o.order_status = 'completed' THEN COALESCE(i.cogs_idr, 0) ELSE 0 END) - 
        o.return_shipping_loss_idr
    ) AS contribution_margin_before_ads_idr
FROM "postgres"."public_stg_silver"."stg_orders" o
LEFT JOIN "postgres"."public_stg_silver"."stg_customers" c ON o.customer_id = c.customer_id
LEFT JOIN item_cogs_agg i ON o.order_id = i.order_id
LEFT JOIN customer_order_seq s ON o.order_id = s.order_id
  );
  
