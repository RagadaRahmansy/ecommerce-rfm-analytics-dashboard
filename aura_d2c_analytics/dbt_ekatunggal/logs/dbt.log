  create  table "postgres"."public_mart_gold"."mart_channel_unit_economics__dbt_tmp"
  
  
    as
  
  (
    -- Gold Layer: mart_channel_unit_economics
WITH monthly_orders AS (
    SELECT
        sales_channel AS channel,
        order_month,
        COUNT(order_id) AS total_orders,
        COUNT(CASE WHEN order_status = 'completed' THEN 1 END) AS completed_orders,
        COUNT(CASE WHEN order_status = 'returned' THEN 1 END) AS returned_orders,
        COUNT(CASE WHEN order_status = 'cancelled' THEN 1 END) AS cancelled_orders,
        COUNT(DISTINCT CASE WHEN buyer_type = 'New Customer Order' AND order_status = 'completed' THEN customer_id END) AS new_paying_customers,
        COUNT(CASE WHEN buyer_type = 'Repeat Customer Order' AND order_status = 'completed' THEN 1 END) AS repeat_orders,
        SUM(gmv_gross_idr) AS gmv_gross_idr,
        SUM(realized_gross_idr) AS realized_gross_idr,
        SUM(discount_idr) AS discount_idr,
        SUM(net_sales_idr) AS net_sales_idr,
        SUM(marketplace_fee_idr) AS marketplace_fee_idr,
        SUM(cogs_idr) AS cogs_idr,
        SUM(return_shipping_loss_idr) AS return_shipping_loss_idr,
        SUM(contribution_margin_before_ads_idr) AS cm_before_ads_idr
    FROM "postgres"."public_mart_gold"."fct_orders"
    GROUP BY sales_channel, order_month
),
monthly_ads AS (
    SELECT
        target_channel AS channel,
        DATE_TRUNC('month', spend_date) AS ad_month,
        SUM(spend_idr) AS ad_spend_idr,
        SUM(impressions) AS total_impressions,
        SUM(clicks) AS total_clicks
    FROM "postgres"."public_stg_silver"."stg_ad_spend"
    GROUP BY target_channel, DATE_TRUNC('month', spend_date)
)
SELECT
    o.channel,
    o.order_month,
    o.total_orders,
    o.completed_orders,
    o.returned_orders,
    o.cancelled_orders,
    o.new_paying_customers,
    o.repeat_orders,
    ROUND((o.returned_orders + o.cancelled_orders)::NUMERIC / NULLIF(o.total_orders, 0) * 100, 2) AS fail_rate_pct,
    o.gmv_gross_idr,
    o.realized_gross_idr,
    o.discount_idr,
    o.net_sales_idr,
    o.marketplace_fee_idr,
    o.cogs_idr,
    o.return_shipping_loss_idr,
    o.cm_before_ads_idr,
    COALESCE(a.ad_spend_idr, 0) AS ad_spend_idr,
    (o.cm_before_ads_idr - COALESCE(a.ad_spend_idr, 0)) AS net_profit_idr,
    ROUND(o.gmv_gross_idr::NUMERIC / NULLIF(COALESCE(a.ad_spend_idr, 0), 0), 2) AS vanity_roas,
    ROUND(o.cm_before_ads_idr::NUMERIC / NULLIF(COALESCE(a.ad_spend_idr, 0), 0), 2) AS contribution_roas,
    ROUND(COALESCE(a.ad_spend_idr, 0)::NUMERIC / NULLIF(o.new_paying_customers, 0), 0) AS cac_idr,
    ROUND((o.cm_before_ads_idr - COALESCE(a.ad_spend_idr, 0))::NUMERIC / NULLIF(o.net_sales_idr, 0) * 100, 2) AS net_margin_pct
FROM monthly_orders o
LEFT JOIN monthly_ads a 
    ON o.channel = a.channel 
    AND o.order_month = a.ad_month
ORDER BY o.order_month ASC, o.channel ASC
  );
  
