  create view "postgres"."public_stg_silver"."stg_orders__dbt_tmp"
    
    
  as (
    -- Silver Layer: stg_orders
-- Menghilangkan 15 webhook duplicate menggunakan ROW_NUMBER()
WITH ranked_orders AS (
    SELECT
        order_id,
        customer_id,
        channel AS sales_channel,
        LOWER(TRIM(order_status)) AS order_status,
        order_date AS ordered_at,
        CAST(order_date AS DATE) AS order_date,
        DATE_TRUNC('month', CAST(order_date AS DATE)) AS order_month,
        gross_amount AS gmv_gross_idr,
        discount_amount AS discount_idr,
        channel_fee_amount AS marketplace_fee_idr,
        return_shipping_loss AS return_shipping_loss_idr,
        payment_method,
        ROW_NUMBER() OVER (
            PARTITION BY order_id 
            ORDER BY order_date ASC
        ) AS rn
    FROM "postgres"."raw_bronze"."raw_orders"
)
SELECT
    order_id,
    customer_id,
    sales_channel,
    order_status,
    ordered_at,
    order_date,
    order_month,
    payment_method,
    gmv_gross_idr,
    discount_amount_idr,
    CASE 
        WHEN order_status = 'completed' THEN gmv_gross_idr 
        ELSE 0 
    END AS realized_gross_idr,
    CASE 
        WHEN order_status = 'completed' THEN (gmv_gross_idr - discount_amount_idr) 
        ELSE 0 
    END AS net_sales_idr,
    CASE 
        WHEN order_status = 'completed' THEN marketplace_fee_idr 
        ELSE 0 
    END AS marketplace_fee_idr,
    CASE 
        WHEN order_status = 'returned' THEN return_shipping_loss_idr 
        ELSE 0 
    END AS return_shipping_loss_idr
FROM (
    SELECT 
        order_id, customer_id, sales_channel, order_status, ordered_at, order_date, order_month, payment_method,
        gmv_gross_idr, discount_idr AS discount_amount_idr, marketplace_fee_idr, return_shipping_loss_idr, rn
    FROM ranked_orders
) ranked
WHERE rn = 1
  );
